              "subnet":         { "id": "REPLACE_ME_subnet_id" },
              "securityGroups": [ { "id": "REPLACE_ME_sg_id" } ]
            }
          },
          "failoverTest": {
            "useDefaultNetwork": false,
            "failoverNetwork": {
              "virtualNetwork": { "id": "REPLACE_ME_vpc_id" },
              "subnet":         { "id": "REPLACE_ME_test_subnet_id" },
              "securityGroups": [ { "id": "REPLACE_ME_sg_id" } ]
            }
          }
        },
        "keyPair":        { "keyName": "REPLACE_ME_keypair_name" },
        "role":           { "roleName": null },
        "tags": [
          { "tagKey": "Environment", "tagValue": "DR-failover" },
          { "tagKey": "CostCenter",  "tagValue": "ops-dr" },
          { "tagKey": "ManagedBy",   "tagValue": "Zerto-ZIC" },
          { "tagKey": "SourceVpg",   "tagValue": "api-test-vpg-tagged" }
        ],
        "launchTemplate": {
          "failover":     { "launchTemplateId": null },
          "failoverTest": { "launchTemplateId": null }
        }
      },
      "vms": []
    }
  }
