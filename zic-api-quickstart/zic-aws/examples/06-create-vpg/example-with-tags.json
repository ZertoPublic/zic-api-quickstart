{
  "vpg": {
    "general": {
      "name": "api-test-vpg-tagged",
      "description": "Created via the ZIC API quickstart, with default recovery tags",
      "protectedRegion":  { "id": "REPLACE_ME_protected_region_id" },
      "protectedAccount": { "id": "REPLACE_ME_protected_account_id" },
      "recoveryRegion":   { "id": "REPLACE_ME_recovery_region_id" },
      "recoveryAccount":  { "id": "REPLACE_ME_recovery_account_id" }
    },
    "protectedResources": {
      "vms": [
        { "id": "REPLACE_ME_aws_instance_id" }
      ]
    },
